NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_URL=your-deepseek-url
DEEPSEEK_MODEL=your-deepseek-model
SERPER_API_KEY=your-serper-api-key
SERPER_URL=your-serper-url
NEXT_PUBLIC_APP_URL=http://localhost:3000
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Google OAuth redirect URIs to register in Google Cloud Console:
#   /api/email/oauth/callback
#   /api/calendar/oauth/callback
#   /api/drive/oauth/callback
#   /api/meet/oauth/callback
MICROSOFT_CLIENT_ID=your-microsoft-client-id
MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret
# Optional: Enable WhatsApp Embedded Signup (guided WABA creation in OAuth dialog)
# Get this from Meta App → WhatsApp → Embedded Signup → Configuration ID
META_WHATSAPP_CONFIG_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=exploro-webhook-verify
CALENDLY_CLIENT_ID=your-calendly-client-id
CALENDLY_CLIENT_SECRET=your-calendly-client-secret
CALENDLY_WEBHOOK_SIGNING_KEY=your-calendly-webhook-signing-key

# ──────────────────────────────────────────────
# Slack
# ──────────────────────────────────────────────
# Create a Slack app at https://api.slack.com/apps → Create New App → Blank app
# App Name: Exploro OS
# Workspace: Select your workspace
# OAuth & Permissions → Bot Token Scopes → add: chat:write, im:history, im:read, im:write, users:read
# OAuth & Permissions → Redirect URLs → add:
#   http://localhost:3000/api/slack/oauth/callback
#   https://exploro-os.com/api/slack/oauth/callback
# Event Subscriptions → Enable → Request URL: https://exploro-os.com/api/slack/events
#   Subscribe to bot events: message.im, im.created
# After installing, get Bot User OAuth Token (xoxb-...) from Install App page
NEXT_PUBLIC_SLACK_CLIENT_ID=your-slack-client-id
SLACK_CLIENT_ID=your-slack-client-id
SLACK_CLIENT_SECRET=your-slack-client-secret
SLACK_BOT_TOKEN=xoxb-your-bot-token

# ──────────────────────────────────────────────
# Telegram
# ──────────────────────────────────────────────
# Create a bot via @BotFather in Telegram → /newbot
# Get the bot token and set it as the gateway bot
# Gateway bot receives forwarded BotFather tokens for easy connection
# Setup: visit /api/telegram/setup-gateway after deploying to register webhook
TELEGRAM_GATEWAY_BOT_TOKEN=your-telegram-gateway-bot-token

# ──────────────────────────────────────────────
# Email sending (Resend)
# ──────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxx

# ──────────────────────────────────────────────
# Cron job secret (for scheduled API routes like trial reminders)
# ──────────────────────────────────────────────
CRON_SECRET=your-random-secret-string

# ──────────────────────────────────────────────
# Stripe — SANDBOX (test mode)
# ──────────────────────────────────────────────
# Get these from https://dashboard.stripe.com/test/developers
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_APIKEY_ID=apikey_test_xxx
STRIPE_APIKEY_TOKEN=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_test_xxx
STRIPE_PRICE_SOLO=price_test_xxx
STRIPE_PRICE_TEAM=price_test_xxx

# ──────────────────────────────────────────────
# Stripe — PRODUCTION (live mode)
# ──────────────────────────────────────────────
# Get these from https://dashboard.stripe.com/developers
# Uncomment and replace with live keys when going to production
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_xxx
# STRIPE_APIKEY_ID=apikey_live_xxx
# STRIPE_APIKEY_TOKEN=sk_live_xxx
# STRIPE_WEBHOOK_SECRET=whsec_live_xxx
# STRIPE_PRICE_SOLO=price_live_xxx
# STRIPE_PRICE_TEAM=price_live_xxx

# ──────────────────────────────────────────────
# Polar.sh
# ──────────────────────────────────────────────
# Get these from https://polar.sh/dashboard/exploro-os
# Organization access token from Settings → Developers → Access Tokens (scoped to your org)
# Product IDs from Products → click product → Copy Product ID
# Webhook secret from Settings → Webhooks → Add Endpoint
POLAR_ACCESS_TOKEN=polar_oat_xxx
POLAR_WEBHOOK_SECRET=polar_whs_xxx
POLAR_PRODUCT_SOLO=product_id_solo_xxx
POLAR_PRODUCT_TEAM=product_id_team_xxx
